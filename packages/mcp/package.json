{
  "name": "@agentpickup/mcp",
  "version": "0.3.2",
  "description": "MCP server for agentPickup: let an AI agent find pickup shops near its user, order, pay by card or in USDC over x402, and hand its user the QR to collect in person.",
  "mcpName": "io.github.dav3trad3r/agentpickup",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentpickup-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "agentic-commerce",
    "agent-payments",
    "click-and-collect",
    "pickup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tokenise-au/agentpickup-sdk.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://agentpickup.app",
  "bugs": {
    "url": "https://github.com/Tokenise-au/agentpickup-sdk/issues"
  },
  "author": "Dave Hallett",
  "license": "FSL-1.1-ALv2",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/extensions": "2.29.0",
    "viem": "^2.57.14",
    "zod": "^4.6.7"
  }
}
