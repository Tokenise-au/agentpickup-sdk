{
  "name": "agentpickup-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp"
  ],
  "scripts": {
    "build": "npm run build -w @agentpickup/core && npm run build -w @agentpickup/mcp",
    "test": "node --conditions=source --import tsx --test packages/core/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
